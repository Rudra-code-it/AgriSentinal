# AgriSentinal Environment Variables
# Never commit real credentials to version control

# Open-Meteo API (no auth required, public endpoint)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/

# CDSE/S3 Copernicus Data Space Ecosystem credentials
# Get these from https://cds.copernicus.eu/
CDSE_USERNAME=your_cdse_username_here
CDSE_PASSWORD=your_cdse_password_here

# CDSE S3-compatible object storage credentials (for authenticated S3 access)
# Get these from https://cds.copernicus.eu/ > Profile > Object Storage
CDSE_S3_ACCESS_KEY=your_cdse_s3_access_key_here
CDSE_S3_SECRET_KEY=your_cdse_s3_secret_key_here
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu

# SoilGrids API (optional, free registration)
SOILGRIDS_USER=your_soilgrids_username_here
SOILGRIDS_PASS=your_soilgrids_password_here